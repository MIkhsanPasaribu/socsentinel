# ========================================
# SOCsentinel — Root Environment Variables
# ========================================
# See backend/.env.example and frontend/.env.example for service-specific vars.

# === General ===
PROJECT_NAME=socsentinel
ENVIRONMENT=development

# === LLM Provider ===
# Options: mock, vllm
LLM_PROVIDER=mock

# === vLLM (AMD MI300X) ===
# Set when LLM_PROVIDER=vllm
# VLLM_API_BASE=http://<mi300x-ip>:8000/v1
# VLLM_MODEL_NAME=Qwen/Qwen3-7B

# === ChromaDB ===
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=mitre_attack

# === Frontend ===
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1
